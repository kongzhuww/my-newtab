{
  "manifest_version": 3,
  "name": "LogicWeaver 新标签页",
  "version": "0.8.0",
  "description": "个人新标签页仪表盘：时钟、B站收藏夹、Todoist 待办、GitHub Star、VPS 探针、小黑盒。",
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "permissions": ["storage", "topSites", "bookmarks", "favicon"],
  "host_permissions": [
    "https://api.bilibili.com/*",
    "https://*.bilibili.com/*",
    "https://api.todoist.com/*",
    "https://api.github.com/*",
    "https://cdn.jsdelivr.net/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://aihot.virxact.com/*",
    "https://monster-siren.hypergryph.com/*",
    "https://*.hycdn.cn/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://player.bilibili.com;"
  },
  "options_page": "options.html",
  "action": { "default_title": "新标签页设置" }
}
